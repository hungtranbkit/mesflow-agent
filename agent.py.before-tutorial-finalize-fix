        stage="VERIFYING"
        deadline=time.time()+180
        last={}
        while time.time()<deadline:
            time.sleep(3)
            try: last=_remote_agent_status(opener,base)
            except Exception as ex: last={"error":str(ex)}; continue
            job=last.get("qa_image_deploy_job") or {}
