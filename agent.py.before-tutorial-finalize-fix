            except Exception:
                old.replace(t); raise
            shutil.rmtree(old,ignore_errors=True)
        else:
            replacement.replace(t)
        append_log(f"QA image-release stored: {v}")
        return v
    finally:
        shutil.rmtree(e,ignore_errors=True)

