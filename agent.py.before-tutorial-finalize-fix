    return """FROM mcr.microsoft.com/playwright:v1.62.1-noble
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \\
 && apt-get install -y --no-install-recommends ffmpeg python3 python3-venv ca-certificates curl \\
 && rm -rf /var/lib/apt/lists/* \\
