                         "built_at":str(meta.get("built_at") or meta.get("created_at") or ""),"current":"CURRENTLY_DEPLOYED" in reasons,"previous":"ROLLBACK_TARGET_OF_LAST_DEPLOY" in reasons,
                         "pinned":(release_dir/"PINNED").is_file(),
